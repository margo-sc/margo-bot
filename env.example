# Токен бота из @BotFather (тот же, что сейчас в Botmother)
BOT_TOKEN=

# Твой Telegram id (узнать: напиши боту /id). Несколько — через запятую
ADMIN_IDS=
# Одноразовый код: напиши боту /claim <код>, и он запомнит тебя как владельца
CLAIM_CODE=
# Куда слать уведомления (по умолчанию — первому из ADMIN_IDS)
ALERT_CHAT_ID=

# Адрес сервера для ссылок на оплату и уведомлений Робокассы
PUBLIC_URL=https://pay.rita-fitt.ru
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Робокасса: Технические настройки магазина
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
# 1 — тестовый режим (тестовые пароли из Робокассы), 0 — боевой
ROBOKASSA_TEST=1
# Алгоритм хеша, как в настройках магазина: md5, sha256 ...
ROBOKASSA_HASH=md5
# 1 — передавать чек (фискализация 54-ФЗ), 0 — не передавать
ROBOKASSA_RECEIPT=1
# Система налогообложения для чека (необязательно): usn_income, npd, osn ...
ROBOKASSA_SNO=

# С какого номера начинать счета (чтобы не пересечься со старыми счетами Botmother)
ORDER_START=500000
